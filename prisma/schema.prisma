// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ---------------- LOOKUP TABLES ----------------

model Organization {
  id         String   @id @default(cuid())
  name       String
  shortName  String   @unique
  slug       String   @unique
  logoUrl    String?
  website    String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notifications Notification[]

  @@index([categoryId])
}

model State {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  notifications Notification[] @relation("NotificationStates")
}

// Sector / recruiting-body category — e.g. SSC, Railway, Banking, UPSC,
// State Govt, Defence, PSU, Police & Security, Teaching, Healthcare,
// Judiciary & Law, Agriculture. Drivesrganization.category and lets
// admins add new sectors without a code deploy.
model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  icon String?

  organizations Organization[]
  notifications Notification[] @relation("NotificationCategories")
}

// Education level — 10th, 12th, ITI, Diploma, Graduate, Post Graduate.
// `level` is used for ordering AND for eligibility comparison
// (user's level must be >= post's required level).
model QualificationCategory {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  order Int    @default(0)

  qualifications Qualification[]
}

model Qualification {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  level Int

  categories   QualificationCategory[]
  branches     Branch[]
  posts        Post[]
  userProfiles UserProfile[]
  @@index([level])
}

// Branch/stream WITHIN a qualification level — e.g. Computer Science,
// Civil, Mechanical (under Engineering); MBBS, Nursing (under Medical);
// B.Com, BCA (under Graduate). Independent of Qualification so a Post
// can require "Graduate + Computer Science" as two separate facts.
model Branch {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  qualificationGroup String // e.g. "Engineering", "Medical", "Graduate" - for UI grouping only

  qualificationId String
  qualification   Qualification @relation(fields: [qualificationId], references: [id])

  posts        Post[]           @relation("PostBranches")
  userProfiles UserProfile[]

  @@index([qualificationId])
}

// What the job actually IS — Clerk, Officer, Engineer, Teacher, Doctor,
// Technician, Manager, etc. Independent of qualification; used as a soft
// preference signal in matching (bonus score), never a hard filter.
model Role {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts             Post[]        @relation("PostRoles")
  preferredByUsers  UserProfile[] @relation("PreferredRoles")
}

// ---------------- CORE ENTITIES ----------------

model Notification {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  published      Boolean  @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  advertisementNo String?
  totalVacancies  Int      @default(0)
  applicationMode ApplicationMode @default(ONLINE)
  officialLink    String

  applicationFeeGeneral String?
  applicationFeeScSt    String?
  selectionProcess      String[] @default([])
  howToApply            String?

  notificationDate     DateTime?
  applicationStartDate DateTime?
  applicationEndDate   DateTime?
  examDate             DateTime?

  status     NotificationStatus @default(LIVE)
  isFeatured Boolean @default(false)

  categories Category[] @relation("NotificationCategories")
  states     State[]    @relation("NotificationStates")

  posts      Post[]
  admitCards AdmitCard[]
  results    Result[]
  answerKeys AnswerKey[]
  documents  Document[]
  links      NotificationLink[]
  importantDates ImportantDate[]
  faqs           NotificationFAQ[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationEndDate])
  @@index([status])
  @@index([organizationId])
  @@index([isFeatured])
}

enum ApplicationMode {
  ONLINE
  OFFLINE
  BOTH
}

enum NotificationStatus {
  UPCOMING
  LIVE
  CLOSED
  CANCELLED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  APPRENTICE
  INTERNSHIP
  TEMPORARY
  DEPUTATION
}

model Post {
  id             String   @id @default(cuid())
  notificationId String

  payScaleMin Int?
  payScaleMax Int?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  title     String
  vacancies Int    @default(0)

  qualificationId String
  qualification   Qualification @relation(fields: [qualificationId], references: [id])

  // A post may require/accept one or more branches (e.g. "any engineering
  // branch"); empty = branch-agnostic, doesn't penalize match score.
  branches Branch[] @relation("PostBranches")

  // What this post actually is - used for soft role-preference matching.
  roles Role[] @relation("PostRoles")

  employmentType EmploymentType @default(PERMANENT)

  minAge Int?
  maxAge Int?
  ageRelaxationNotes String?
  ageRelaxation      Json?
  physicalCriteria   Json?
  educationDetails   String?
  payScale String?

  categoryWiseVacancies Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([notificationId])
}

model AdmitCard {
  id             String   @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  title        String
  releaseDate  DateTime?
  examDate     DateTime?
  downloadLink String
  createdAt    DateTime @default(now())

  @@index([notificationId])
  @@index([releaseDate])
}

model Result {
  id             String   @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  title       String
  resultType  ResultType @default(FINAL)
  releaseDate DateTime?
  resultLink  String
  createdAt   DateTime @default(now())

  @@index([notificationId])
  @@index([releaseDate])
}

enum ResultType {
  PRELIMS
  MAINS
  MERIT_LIST
  FINAL
  INTERVIEW
}

model AnswerKey {
  id               String   @id @default(cuid())
  notificationId   String
  notification     Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  title            String
  keyType          AnswerKeyType @default(PROVISIONAL)
  releaseDate      DateTime?
  downloadLink     String
  objectionEndDate DateTime?
  createdAt        DateTime @default(now())

  @@index([notificationId])
}

enum AnswerKeyType {
  PROVISIONAL
  FINAL
}

model Document {
  id             String   @id @default(cuid())
  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  title     String
  docType   DocumentType
  fileUrl   String
  createdAt DateTime @default(now())

  @@index([docType])
}

enum DocumentType {
  SYLLABUS
  EXAM_PATTERN
  SELECTION_PROCESS
  PREVIOUS_PAPER
  EXAM_CALENDAR
  OTHER
}

// ---------------- USER-SIDE ENTITIES ----------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatarUrl    String?
  authProvider AuthProvider @default(EMAIL)
  passwordHash String?

  accounts     Account[]
  sessions     Session[]

  profile      UserProfile?
  savedJobs    SavedJob[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth DateTime?
  gender      String?
  category    String?
  stateId     String?

  qualificationId String?
  qualification   Qualification? @relation(fields: [qualificationId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  preferredRoles Role[] @relation("PreferredRoles")
  preferredEmploymentTypes EmploymentType[] @default([])

  degreeName      String?
  yearOfPassing   Int?
  percentage      Float?

  resumeUrl       String?
  profileStrength Int    @default(0)

  updatedAt DateTime @updatedAt

  @@index([branchId])
}

model SavedJob {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  createdAt      DateTime @default(now())

  @@unique([userId, notificationId])
}

model Application {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String

  status    ApplicationStatus @default(APPLIED)
  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, notificationId])
  @@index([status])
}

enum ApplicationStatus {
  APPLIED
  EXAM_SCHEDULED
  RESULT_AWAITED
  SELECTED
  REJECTED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NotificationLink {
  id             String   @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  label    String
  url      String
  linkType LinkType @default(OTHER)
  order    Int      @default(0)

  createdAt DateTime @default(now())

  @@index([notificationId])
}

enum LinkType {
  APPLY_ONLINE
  NOTIFICATION_PDF
  OFFICIAL_WEBSITE
  ADMIT_CARD
  RESULT
  SYLLABUS
  SHORT_NOTICE
  OTHER
}

model ImportantDate {
  id             String   @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  label String   // "Application Start", "Pre-Exam Training", "Main Exam Date", etc.
  date  DateTime
  order Int      @default(0)

  createdAt DateTime @default(now())

  @@index([notificationId])
}

model NotificationFAQ {
  id             String   @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  question String
  answer   String
  order    Int    @default(0)

  createdAt DateTime @default(now())

  @@index([notificationId])
}
